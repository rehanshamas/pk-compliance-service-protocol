# CIP Environment Variables
# Copy to .env and adjust for local development
# cp .env.example .env

# Database (default works with docker-compose Postgres)
DATABASE_URL=postgresql+asyncpg://cip:cip@localhost:5432/cip

# Redis (default works with docker-compose)
REDIS_URL=redis://localhost:6379/0

# JWT — RS256 asymmetric signing (generate keys: python scripts/generate_jwt_keys.py)
JWT_PRIVATE_KEY_PATH=jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins for frontend (include 127.0.0.1 if used)
# For network access (e.g. http://192.168.x.x:3000), add that origin
# Production: CORS_ORIGINS=https://paiso.io,https://www.paiso.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3/MinIO storage (Phase 8.3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cip-records
# S3 server-side encryption (AES256). Set true for AWS S3; MinIO may need encryption config.
S3_SSE_ENABLED=false
# Optional: 32-byte base64 key for future field-level encryption. Leave empty for no field encryption.
# ENCRYPTION_KEY=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Identity verification provider: nadra | shufti. Admin switch — use shufti when NADRA unavailable.
IDENTITY_VERIFICATION_PROVIDER=nadra
# NADRA (Phase 7): mock | sandbox | real
NADRA_ADAPTER=mock
# NADRA sandbox/production: set when credentials available
# NADRA_BASE_URL=
# NADRA_CLIENT_ID=
# NADRA_CLIENT_SECRET=
# NADRA_TIMEOUT_SECONDS=10
# Shufti Pro e-IDV (Phase 7 fallback): set when using IDENTITY_VERIFICATION_PROVIDER=shufti
# Register callback URL in Shufti backoffice before enabling.
# SHUFTI_CLIENT_ID=
# SHUFTI_SECRET_KEY=
# SHUFTI_BASE_URL=https://api.shuftipro.com
# SHUFTI_CALLBACK_URL=https://your-api.example.com/api/v1/webhooks/shufti
ANALYTICS_COMMERCIAL_PROVIDER=mock
